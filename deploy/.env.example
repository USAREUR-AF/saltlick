# Copy to .env and edit. .env is gitignored.
# Nothing here is a secret: the directory holds public packages, and writes are
# authenticated by keys the publishing parties hold, not by anything you set.

# Internal hostname you serve the directory on. It must resolve, on the network
# your readers are on, to the address in BIND_ADDR below.
SALTLICK_DOMAIN=directory.internal.example

# Which interface to listen on. The default binds to loopback, which reaches
# nothing but this machine — good for a first run, useless to anyone else. Set
# it to this host's address on your internal network.
#
# The directory is not meant to be internet-facing. Do not set this to 0.0.0.0
# on a host with a public interface.
BIND_ADDR=127.0.0.1

# Pin a released version rather than tracking latest.
SALTLICK_IMAGE=ghcr.io/desertgoat/saltlick:latest
