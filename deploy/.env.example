# Copy to .env and edit. .env is gitignored.
# Nothing here is a secret: the directory holds public packages, and writes are
# authenticated by keys the publishing parties hold, not by anything you set.

# Public hostname the directory is served on. It needs a public DNS A (or AAAA)
# record pointing at this host, so Caddy can obtain a certificate for it.
SALTLICK_DOMAIN=directory.example

# Interface Caddy listens on for 80 and 443. 0.0.0.0 is every interface, which
# is the expected case for an internet-reachable host. Set a single address to
# serve on one interface only.
BIND_ADDR=0.0.0.0

# A released version, pinned. A digest pins the bytes; a tag alone can move.
#   ghcr.io/usareur-af/saltlick:v0.1.0@sha256:<index digest from the release>
SALTLICK_IMAGE=ghcr.io/usareur-af/saltlick:v0.1.0

# Compose network shared by Caddy and the directory. The directory believes
# X-Forwarded-For only from this range. Change it if it collides on this host.
# SALTLICK_SUBNET=172.30.53.0/24

# Per-source budgets. Rates are N/s, N/m or N/h; 0 turns a budget off.
# SALTLICK_READ_LIMIT=10/s
# SALTLICK_READ_BURST=30
# SALTLICK_WRITE_LIMIT=6/m
# SALTLICK_WRITE_BURST=6
