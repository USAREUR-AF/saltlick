# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.
# Nothing in this file is a secret; AWS credentials come from your environment
# or profile, never from here.

aws_region = "eu-west-1"
image      = "ghcr.io/usareur-af/saltlick:v1.0.0"

# A public ACM certificate in this region for the public name you will serve
# the directory on.
certificate_arn = "arn:aws:acm:eu-west-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"

# The load balancer is internet-facing by default, and who may reach it has no
# default. Every party:
allowed_cidr_blocks = ["0.0.0.0/0"]

# To run it on a private network instead:
# internet_facing     = false
# allowed_cidr_blocks = ["10.20.0.0/16"]

# Optional overrides:
# name               = "saltlick"
# log_retention_days = 30
# tags               = { owner = "example-coalition" }
